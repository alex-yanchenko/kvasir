{
  "name": "kvasir",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "Turn a GitHub PR into an interactive, in-browser walkthrough with a select-code-and-ask modal, powered by a local Claude Code channel.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "kvasir-setup": "bun packages/mimir/scripts/setup.ts",
    "mimir": "pnpm --filter @kvasir/mimir start",
    "build": "pnpm --filter @kvasir/extension build",
    "package:extension": "pnpm build && bun packages/mimir/src/packageExtension.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "knip": "knip",
    "type-coverage": "type-coverage --strict --at-least 98",
    "size": "pnpm build && size-limit",
    "spell": "cspell \"packages/*/src/**/*.{ts,tsx}\" \"*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "e2e": "pnpm build && playwright test",
    "mutation": "NODE_OPTIONS=--no-experimental-webstorage stryker run"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@size-limit/file": "^14.3.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "cspell": "^10.4.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-sonarjs": "~4.0.3",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "type-coverage": "^2.31.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
